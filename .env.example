# Optional. Als .env neben die docker-compose.yml legen und anpassen.
# Ohne .env läuft alles, nur „Passwort vergessen“ und Einladungen per E-Mail fehlen.

# Port auf dem Rechner (Standard 8080, ändern, falls belegt)
NK_PORT=8080

# Unveränderlicher, zufälliger Wert für Sitzungen sowie Einladungs-/Reset-Links.
# Für mehrere Replikate zwingend in allen Pods identisch aus einem Secret setzen.
# Erzeugen z. B. mit: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=bitte-durch-einen-langen-zufaelligen-wert-ersetzen

# Datenbank: nicht gesetzt = interne SQLite-Datei im Volume /data (Standard).
# Für eine externe PostgreSQL-Datenbank die vollständige URL setzen. Sonderzeichen in Benutzername/Passwort
# müssen URL-kodiert sein. PostgreSQL ist der einzige unterstützte externe SQL-Server.
# DATABASE_URL=postgresql://immobilienverwalter:passwort@db.example.de:5432/immobilienverwalter?sslmode=require
# DB_CONNECT_TIMEOUT=5

# Adresse der App im Netzwerk, für Links in E-Mails
APP_URL=http://192.168.1.10:8080

# E-Mail-Versand: Raute entfernen und eigene Daten eintragen
# SMTP_HOST=smtp.example.de
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # starttls (Port 587), ssl (Port 465) oder none
# SMTP_USER=benutzer@example.de
# SMTP_PASSWORD=geheim
# SMTP_FROM=Immobilienverwalter <benutzer@example.de>
